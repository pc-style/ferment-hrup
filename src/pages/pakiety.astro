    icon: `<path d="M8 16l6 6 10-12" stroke="#e00371" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><rect x="4" y="4" width="24" height="24" rx="4" stroke="#e00371" stroke-width="2"/>`,
  },
  {
    name: "HRup Team",
    price: "3 500 zł",
    description: "Audyt komunikacji w zespole, rozpisanie ról, warsztaty dla liderów",
    icon: `<circle cx="10" cy="12" r="4" stroke="#e00371" stroke-width="2"/><circle cx="22" cy="12" r="4" stroke="#e00371" stroke-width="2"/><path d="M4 26c0-4 4-7 6-7h4c2 0 6 3 6 7M18 26c0-4 4-7 6-7h2c2 0 6 3 6 7" stroke="#e00371" stroke-width="2" stroke-linecap="round"/>`,
  },
