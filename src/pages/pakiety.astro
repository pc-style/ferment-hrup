const categories = [
  {
    id: "frontline",
    label: "Frontline",
    sublabel: "Stanowiska podstawowe",
    packages: frontlinePackages,
  },
  {
    id: "talent",
    label: "Talent",
    sublabel: "Specjaliści",
    packages: talentPackages,
