---
import Base from "../layouts/Base.astro";
import Marquee from "../components/Marquee.astro";

const services = [
  {
    title: "Onboarding",
    description:
      "Mapowanie kompetencji, checklisty wdrożeniowe, monitoring i wsparcie przez pierwsze 30-60 dni.",
    icon: `<circle cx="24" cy="24" r="20" stroke="#e00371" stroke-width="2" fill="none" /><path d="M24 14v10l7 4" stroke="#e00371" stroke-width="2" stroke-linecap="round" />`,
  },
  {
    title: "Rekrutacja",
    description:
      "Pełny proces rekrutacyjny – od profilu kandydata, przez ogłoszenia i sourcing, po rozmowy i rekomendacje.",
    icon: `<circle cx="24" cy="24" r="20" stroke="#e00371" stroke-width="2" fill="none" /><path d="M16 24l6 6 10-12" stroke="#e00371" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />`,
  },
  {
    title: "Wsparcie zespołów",
    description:
      "Audyt komunikacji, klarowność ról, warsztaty dla liderów i poprawa współpracy w zespole.",
    icon: `<circle cx="24" cy="24" r="20" stroke="#e00371" stroke-width="2" fill="none" /><circle cx="17" cy="20" r="2" fill="#e00371" /><circle cx="31" cy="20" r="2" fill="#e00371" /><path d="M16 30c2 4 6 6 8 6s6-2 8-6" stroke="#e00371" stroke-width="2" fill="none" stroke-linecap="round" />`,
  },
  {
    title: "Kultura organizacyjna",
    description:
      "Analiza procesów HR, rekomendacje zmian i wdrożenie powtarzalnych systemów – by klient skupił się na tworzeniu kultury.",
    icon: `<circle cx="24" cy="24" r="20" stroke="#e00371" stroke-width="2" fill="none" /><path d="M24 14l3 6 7 1-5 5 1.2 7-6.2-3.3L17.8 33 19 26l-5-5 7-1z" fill="#e00371" />`,
  },
  {
    title: "HR Strategiczny",
    description:
      "Projektowanie struktury organizacji, monitorowanie parametrów zaangażowania i budowanie kultury organizacyjnej.",
    icon: `<circle cx="24" cy="24" r="20" stroke="#e00371" stroke-width="2" fill="none" /><circle cx="24" cy="18" r="6" fill="#e00371" /><path d="M12 38c0-6.627 5.373-12 12-12s12 5.373 12 12" stroke="#e00371" stroke-width="2" fill="none" />`,
  },
];

const clients = [
  "Kina studyjne i sieciowe",
  "Dystrybutorzy filmowi",
  "Festiwale i wydarzenia filmowe",
  "Fundacje i instytucje kultury",
  "Małe zespoły kreatywne",
];

const marqueeItems = ["KULTURY", "KINA", "FESTIWALI", "DYSTRYBUCJI", "ZESPOŁÓW"];
---

<Base title="HRup - ludzie z kulturą | Ferment Kolektiv">
  <!-- Hero -->
  <section
    class="relative flex min-h-[calc(100vh-5rem)] items-center justify-center overflow-hidden bg-brand-black"
  >
    <!-- Projector beam -->
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 70% 55% at 50% -10%, rgba(224,3,113,0.13), transparent 70%);"
    >
    </div>
    <div
      class="pointer-events-none absolute top-1/2 left-1/2 h-[600px] w-[600px] -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-pink/5 blur-3xl"
    >
    </div>

    <div class="relative z-10 mx-auto max-w-[1280px] px-6 text-center">
      <div class="line-reveal" style="--line-delay: 0s">
        <p class="mb-4 text-sm tracking-[0.3em] text-brand-white uppercase">
          HRup – Twój partner HR dla branży kulturalnej
        </p>
      </div>

      <h1
        class="text-5xl leading-none font-bold tracking-tight text-white md:text-7xl lg:text-8xl"
      >
        <span class="line-reveal" style="--line-delay: 0.15s">
          <span>ludzie <span class="text-brand-pink">z</span> kulturą</span>
        </span>
      </h1>

      <div class="line-reveal" style="--line-delay: 0.35s">
        <p class="mt-6 text-xl text-white md:text-2xl">
          Twój zespół. Nasza troska.
        </p>
      </div>

      <div class="line-reveal mt-10" style="--line-delay: 0.55s">
        <span>
          <a
            href="/kontakt"
            class="inline-block rounded-full bg-brand-pink px-10 py-4 text-sm font-semibold tracking-widest text-white transition-all duration-300 hover:scale-[1.03] hover:bg-brand-pink/90 hover:shadow-[0_0_36px_rgba(224,3,113,0.4)]"
          >
            POROZMAWIAJMY
          </a>
        </span>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce motion-reduce:hidden">
      <svg
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#717173"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M6 9l6 6 6-6"></path>
      </svg>
    </div>
  </section>

  <!-- Marquee strip -->
  <Marquee items={marqueeItems} />

  <!-- Mission & Vision -->
  <section class="bg-brand-dark py-24 md:py-32">
    <div class="mx-auto max-w-[1280px] px-6">
      <div class="grid gap-16 md:grid-cols-2 md:gap-24">
        <div data-reveal>
          <p class="mb-3 text-xs font-semibold tracking-[0.3em] text-brand-pink uppercase">01</p>
          <h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">MISJA</h2>
          <p class="text-base leading-relaxed font-light text-brand-grey md:text-lg">
            Wspieramy instytucje kultury i kina w skutecznym pozyskiwaniu,
            wdrażaniu i utrzymywaniu najlepszych pracowników, zapewniając
            procesy HR dopasowane do realiów branży.
          </p>
        </div>

        <div data-reveal style="--reveal-delay: 0.15s">
          <p class="mb-3 text-xs font-semibold tracking-[0.3em] text-brand-pink uppercase">02</p>
          <h2 class="mb-6 text-3xl font-bold text-white md:text-4xl">WIZJA</h2>
          <p class="text-base leading-relaxed font-light text-brand-grey md:text-lg">
            Chcemy, aby każda instytucja kultury miała prosty, efektywny i
            powtarzalny system HR, który pozwala koncentrować się na tworzeniu
            kultury, a nie na zarządzaniu rotacją i chaosem kadrowym.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="bg-brand-black py-24 md:py-32">
    <div class="mx-auto max-w-[1280px] px-6">
      <h2
        class="mb-6 text-center text-3xl font-bold text-white md:text-4xl"
        data-reveal
      >
        <span class="text-brand-pink">dla</span> TWOJEJ ORGANIZACJI
      </h2>
      <p
        class="mx-auto mb-16 max-w-2xl text-center text-brand-grey"
        data-reveal
        style="--reveal-delay: 0.1s"
      >
        Zakres proponowanych usług – od HR strategicznego, przez rekrutacje, po
        budowanie kultury organizacyjnej
      </p>

      <div class="grid gap-6 md:grid-cols-3">
        {
          services.map((service, index) => (
            <div
              class="spotlight group rounded-xl border border-brand-grey/20 bg-brand-dark p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-pink/40 hover:shadow-[0_0_30px_rgba(224,3,113,0.08)]"
              data-reveal
              style={`--reveal-delay: ${index * 0.08}s`}
            >
              <div class="mb-6 opacity-80 transition-all duration-300 group-hover:scale-110 group-hover:opacity-100">
                <svg viewBox="0 0 48 48" class="h-10 w-10" set:html={service.icon} />
              </div>
              <h3 class="mb-3 text-xl font-semibold text-white">
                {service.title}
              </h3>
              <p class="text-sm leading-relaxed font-light text-brand-grey">
                {service.description}
              </p>
            </div>
          ))
        }
        <a
          href="/uslugi"
          class="spotlight group flex flex-col items-start justify-end rounded-xl border border-brand-pink/30 bg-gradient-to-br from-brand-pink/10 to-transparent p-8 transition-all duration-300 hover:-translate-y-1 hover:border-brand-pink/60 hover:shadow-[0_0_30px_rgba(224,3,113,0.15)]"
          data-reveal
          style={`--reveal-delay: ${services.length * 0.08}s`}
        >
          <span class="mb-3 text-xl font-semibold text-white">
            Wszystkie usługi
          </span>
          <span
            class="inline-flex items-center gap-2 text-sm font-semibold tracking-widest text-brand-pink uppercase"
          >
            Zobacz
            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 0 16 16"
              fill="none"
            >
              <path
                d="M2 8h12M9 3l5 5-5 5"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- For Whom -->
  <section class="bg-brand-dark py-24 md:py-32">
    <div class="mx-auto max-w-[1280px] px-6">
      <h2 class="mb-16 text-3xl font-bold text-white md:text-4xl" data-reveal>
        <span class="text-brand-pink">dla</span> KOGO PRACUJEMY
      </h2>

      <div class="grid gap-12 md:grid-cols-2">
        <div class="space-y-4">
          {
            clients.map((client, i) => (
              <div
                class="group border-l-2 border-brand-pink py-3 pl-6 transition-all duration-300 hover:border-l-4 hover:bg-brand-black/30 hover:pl-8"
                data-reveal="left"
                style={`--reveal-delay: ${i * 0.08}s`}
              >
                <p class="text-lg text-brand-grey transition-colors duration-200 group-hover:text-white">
                  {client}
                </p>
              </div>
            ))
          }
        </div>
        <div class="flex items-center" data-reveal style="--reveal-delay: 0.25s">
          <p class="text-lg leading-relaxed text-white md:text-xl">
            Znamy realia pracy w kulturze: wielozadaniowość, ograniczone
            budżety, sezonowość, presję i pasję. Dlatego nasze rozwiązania są
            dopasowane do specyfiki branży.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Start date -->
  <section class="relative overflow-hidden bg-brand-black py-24 md:py-32">
    <div
      class="pointer-events-none absolute inset-0"
      style="background: radial-gradient(ellipse 60% 60% at 50% 110%, rgba(224,3,113,0.1), transparent 70%);"
    >
    </div>
    <div class="relative mx-auto max-w-[1280px] px-6 text-center">
      <p
        class="mb-4 text-sm tracking-widest text-brand-grey uppercase"
        data-reveal
      >
        Start działalności od
      </p>

      <h2
        class="mb-6 text-5xl font-bold text-white md:text-7xl"
        data-reveal
        style="--reveal-delay: 0.1s"
      >
        <span class="text-brand-pink">06</span>.2026
      </h2>

      <p class="mb-4 text-lg text-brand-grey" data-reveal style="--reveal-delay: 0.2s">
        Konsultacje możliwe już teraz
      </p>

      <div
        class="mb-10 flex items-center justify-center gap-4"
        data-reveal
        style="--reveal-delay: 0.25s"
      >
        <span class="font-medium text-brand-pink">Asia</span>
        <span class="text-brand-grey">•</span>
        <span class="font-medium text-brand-pink">Paulina</span>
      </div>

      <div data-reveal style="--reveal-delay: 0.3s">
        <a
          href="/kontakt"
          class="inline-block rounded-full bg-brand-pink px-10 py-4 text-sm font-semibold tracking-widest text-white transition-all duration-300 hover:scale-[1.03] hover:bg-brand-pink/90 hover:shadow-[0_0_36px_rgba(224,3,113,0.4)]"
        >
          POROZMAWIAJMY
        </a>
      </div>
    </div>
  </section>
</Base>
